// trigger build
//
// "main" + the "binding" line below add one tiny live-price API route
// (/api/quote) on top of the plain static site. Everything else is
// served exactly as before. See HOW-TO-LIVE-PRICES.md for the
// one-time setup this needs (a free API key + one Cloudflare secret).
{
  "name": "daily-pick-investing",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
